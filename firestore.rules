rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'usitakatelvin@gmail.com' ||
        request.auth.token.email == 'smartchoiceglobalresourcesltd@gmail.com'
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Dynamic Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Homepage Slides
    match /slides/{slideId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow read: if true; // Allows order tracking by reference and email/phone
      allow create: if incoming().totalAmount is number && incoming().totalAmount > 0;
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.customerId == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'orderStatus'])
      );
      allow delete: if isAdmin();
    }

    // Save To Buy Plans
    match /saveToBuyPlans/{planId} {
      allow read: if true; // For customer plan tracking
      allow create: if incoming().totalPayable is number && incoming().totalPayable > 0;
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.customerId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // Payment Receipts
    match /payments/{paymentId} {
      allow read: if true;
      allow create: if incoming().amount is number && incoming().amount > 0;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Klump BNPL Transactions
    match /klumpTransactions/{txId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Contact Messages
    match /contactMessages/{messageId} {
      allow create: if incoming().email is string && incoming().email.size() <= 150;
      allow read, update, delete: if isAdmin();
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Admin Markers
    match /admins/{adminUid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
